{
  "Items": [
    {
      "type": "disableMovement"
    },
    {
      "type": "dialog",
      "text": "Ah, the Dreamwalker. You must have some experience in a place like this.",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "dialog",
      "text": "Everyone who sleeps dreams somewhere in this realm. Most of us can only look in from outside.",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "dialog",
      "text": "But a Dreamwalker can step right inside. Touch someone while they sleep, and in you go.",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "dialog",
      "text": "Inside, you can read their memories, talk with them, or even wake them up.",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "dialog",
      "text": "My magic carpet and I have explored for many years, and there are always new things to discover.",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "dialog",
      "text": "Now that you have begun to walk in dreams, I suspect your nights will get much more interesting.",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "dialog",
      "text": "I suppose that is all we have for class today.",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "closeDialog"
    },
    {
      "type": "clearFade"
    },
    {
      "type": "fadeIn",
      "name": "BlackFade"
    },
    {
      "type": "editObjects",
      "loadObjs": [
        {
          "type": "Seer",
          "name": "Seer",
          "location": "-2.25,-1.5",
          "facing": "down"
        },
        {
          "type": "Wally",
          "name": "Wally",
          "location": "0, -0.5",
          "facing": "down"
        },
        {
          "type": "Sandman",
          "name": "Sandman",
          "location": "-3, -3.5",
          "facing": "down"
        },
        {
          "type": "Songbird",
          "name": "Songbird",
          "location": "0, -6.5",
          "facing": "up"
        },
        {
          "type": "Dreamy",
          "name": "Dreamy",
          "location": "2.25, -5.5",
          "facing": "up"
        },
        {
          "type": "Maven",
          "name": "Maven",
          "location": "0, -3.5",
          "facing": "down"
        }
      ]
    },
    {
      "type": "wait",
      "text": 1
    },
    {
      "type": "moveFace",
      "name": "Maven",
      "direction": "down"
    },
    {
      "type": "teleport",
      "name": "Player",
      "text": "3, -3.5"
    },
    {
      "type": "moveFace",
      "name": "Player",
      "direction": "down"
    },
    {
      "type": "fadeOut",
      "name": "BlackFade"
    },
    {
      "type": "dialog",
      "text": "Well class, that is enough exploring for one day.",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "dialog",
      "text": "We have the rest of the school year to learn more.",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "dialog",
      "text": "Let us return!",
      "name": "Maven",
      "isTyped": "true"
    },
    {
      "type": "closeDialog"
    },
    {
      "type": "playSound",
      "name": "teleport"
    },
    {
      "type": "dreamExit"
    },
    {
      "type": "setSceneCounter",
      "text": 1
    },
    {
      "type": "loadScene",
      "name": "MentalClassroom"
    }
  ]
}